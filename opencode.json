{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "primary",
  "lsp": false,
  "provider": {
    "isoquant": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Isoquant",
      "options": {
        "baseURL": "https://api.isoquant.ai/v1",
        "apiKey": "{env:ISOQUANT_API_KEY}",
        "headers": {
          "Isoquant-ZDR": "required"
        }
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  }
}
