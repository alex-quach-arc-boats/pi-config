{
  "defaultProvider": "isoquant",
  "defaultModel": "glm-5.3-flash",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "modelThinkingLevels": {
    "isoquant/glm-5.3-flash": "max",
    "opencode/gpt-6.1-sol": "medium"
  },
  "extensions": [
    "-builtin:mcp",
    "-builtin:codemode",
    "-builtin:tool-search"
  ],
  "packages": [
    {
      "source": "/home/alex/github/pi-subagents",
      "extensions": [
        "index.ts"
      ],
      "skills": [],
      "prompts": []
    },
    "npm:pi-zentui@0.30.0",
    "npm:pi-collapse-tools@0.1.11"
  ],
  "subagents": {
    "disableBuiltins": true
  },
  "lastChangelogVersion": "1.1.0",
  "hideThinkingBlock": true,
  "quietStartup": false,
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "theme": "tomorrow-night",
  "enabledModels": [
    "opencode/glm-5.3-flash",
    "opencode/gpt-6-luna",
    "isoquant/glm-5.3-flash",
    "opencode/gpt-6.1-sol"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "doubleEscapeAction": "tree",
  "terminal": {
    "showTerminalProgress": false
  },
  "fullscreenExitOutput": "resume-hint",
  "editorPaddingX": 1,
  "outputPad": 1,
  "compaction": {
    "enabled": true
  },
  "treeFilterMode": "default",
  "tuiMode": "fullscreen"
}